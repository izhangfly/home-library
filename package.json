{
  "name": "home-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.mts",
    "icons": "tsx scripts/make-icons.mts",
    "smoke:deepseek": "tsx scripts/smoke-deepseek.mts",
    "smoke:sources": "tsx scripts/smoke-sources.mts",
    "check:i18n": "tsx scripts/check-i18n.mts",
    "reset": "tsx scripts/reset.mts",
    "compare:sources": "tsx scripts/compare-sources.mts",
    "compare:covers": "tsx scripts/compare-covers.mts",
    "verify:layout": "tsx scripts/verify-layout.mts",
    "verify:clc": "tsx scripts/verify-clc.mts",
    "verify:ratelimit": "tsx scripts/verify-ratelimit.mts",
    "verify:calibrate": "tsx scripts/verify-calibrate.mts",
    "verify:ssrf": "tsx scripts/verify-ssrf.mts",
    "verify:export": "tsx scripts/verify-export.mts",
    "verify:confirm": "tsx scripts/verify-confirm.mts",
    "verify:dberrors": "tsx scripts/verify-dberrors.mts",
    "check:derived": "tsx scripts/check-derived.mts",
    "measure:clc": "tsx scripts/measure-clc.mts",
    "verify": "npm run typecheck && npm run check:i18n && npm run verify:clc && npm run verify:ssrf && npm run verify:ratelimit && npm run verify:calibrate && npm run verify:export && npm run verify:confirm && npm run verify:dberrors && npm run verify:layout && npm run verify:insert && npm run verify:roommatch && npm run verify:concurrency && npm run measure:clc && npm run check:agent",
    "smoke": "node scripts/smoke.mjs",
    "measure:layout": "tsx scripts/measure-layout.mts",
    "check:agent": "tsx scripts/check-backup-agent.mts",
    "verify:concurrency": "tsx scripts/verify-concurrency.mts",
    "verify:roommatch": "tsx scripts/verify-roommatch.mts",
    "measure:churn": "MEASURE_IMPORT=1 tsx scripts/measure-churn.mts",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:full": "npm run verify && LAYOUT_PERF=1 npm run verify:layout && npm run measure:layout && npm run measure:churn",
    "verify:insert": "tsx scripts/verify-insert.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.4.2",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "pg": "^8.22.0",
    "pinyin-pro": "^3.28.2",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@prisma/engines": true,
    "@swc/core": true,
    "prisma": true,
    "unrs-resolver": true,
    "esbuild": true
  }
}
